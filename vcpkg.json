{
  "name": "async-net",
  "version-string": "1.0.0",
  "description": "High-performance C++20 coroutine-based async network library",
  "homepage": "",
  "license": "MIT",
  "dependencies": [
    {
      "name": "wolfssl",
      "features": [
        "quic",
        "dtls"
      ],
      "platform": "!uwp"
    },
    {
      "name": "ngtcp2",
      "features": [
        "wolfssl"
      ]
    },
    {
      "name": "protobuf",
      "platform": "!uwp"
    }
  ],
  "features": {
    "awslc": {
      "description": "Use AWS-LC as SSL backend (replaces wolfSSL)",
      "dependencies": [
        {
          "name": "aws-lc",
          "platform": "!uwp"
        }
      ]
    },
    "libressl": {
      "description": "Use LibreSSL >= 3.9.2 as SSL backend (QUIC/HTTP3 supported)",
      "dependencies": [
        {
          "name": "libressl",
          "platform": "!uwp"
        }
      ]
    }
  }
}
